# Add your Gemini API key in your local .env file.
GEMINI_API_KEY=

# Optional settings shown with their application defaults.
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_PATH=data/chunks.json
TOP_K=3
# Leave blank until calibrated against the university dataset.
MAX_DISTANCE=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ASSISTANT_ROLE="مساعد معلومات يعتمد على المستندات المتاحة"
